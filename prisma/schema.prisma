// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Coach
  Client
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  role     Role
  qr_code  String?

  // Detalles específicos según el rol
  clientDetail Client_Detail?
  coachDetail  Coach_Detail?

  // RELACIONES DE MEMBRESÍA
  memberships         Membership[] @relation("UserMemberships")
  membershipsAsCoach Membership[] @relation("CoachAssignment")

  // Relaciones de entrenamiento y nutrición
  routinesAsClient Routine[]      @relation("ClientRoutines")
  routinesAsCoach  Routine[]      @relation("CoachRoutines")
  sentMessages     Chat_Message[] @relation("SentMessages")
  receivedMessages Chat_Message[] @relation("ReceivedMessages")
  logAsClient      Training_Log[]
  mealPlans        Meal_Plan[]
}

model Client_Detail {
  id                String             @id @default(uuid())
  user_id           String             @unique
  user              User               @relation(fields: [user_id], references: [id])
  blood_type        String?
  pathologies       String?
  allergies         String?
  observations      String?
  emergency_contact String?
  physicalProfiles  Physical_Profile[]
}

model Coach_Detail {
  id                String  @id @default(uuid())
  user_id           String  @unique
  user              User    @relation(fields: [user_id], references: [id])
  blood_type        String?
  pathologies       String?
  allergies         String?
  observations      String?
  emergency_contact String?
}

model Gym {
  id          String       @id @default(uuid())
  name        String
  address     String
  memberships Membership[]
  coupons     Coupon[]
}

model Membership {
  id String @id @default(uuid())

  user_id String
  user    User   @relation("UserMemberships", fields: [user_id], references: [id])

  gym_id String
  gym    Gym    @relation(fields: [gym_id], references: [id])

  coach_id String?
  coach    User?   @relation("CoachAssignment", fields: [coach_id], references: [id])

  status String
}

model Physical_Profile {
  id                  String        @id @default(uuid())
  client_detail_id    String
  client_detail       Client_Detail @relation(fields: [client_detail_id], references: [id])
  weight              Float
  height              Float
  body_fat_percentage Float?
  recorded_at         DateTime      @default(now())
}

model Exercise {
  id           String @id @default(uuid())
  name         String
  muscle_group String
  media_url    String?
  
  gym_id       String?
  is_custom    Boolean @default(false)
  
  routineExercises Routine_Exercise[]
}

model Routine {
  id          String        @id @default(uuid())
  client_id   String
  client      User          @relation("ClientRoutines", fields: [client_id], references: [id])
  coach_id    String
  coach       User          @relation("CoachRoutines", fields: [coach_id], references: [id])
  title       String        // Ej: "Rutina PPL Hipertrofia"
  description String?       // Notas generales
  created_at  DateTime      @default(now())
  end_date    DateTime?     // Fecha estimada de cambio de rutina
  days        Routine_Day[] // Relación con los bloques de días
}

model Routine_Day {
  id         String             @id @default(uuid())
  routine_id String
  routine    Routine            @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  name       String             // Ej: "Día 1 - Empuje (Push)", "Día A"
  order      Int                // Orden cronológico (1, 2, 3...)
  exercises  Routine_Exercise[]
}

model Routine_Exercise {
  id             String       @id @default(uuid())
  routine_day_id String
  routineDay     Routine_Day  @relation(fields: [routine_day_id], references: [id], onDelete: Cascade)
  exercise_id    String
  exercise       Exercise     @relation(fields: [exercise_id], references: [id])
  
  series         Int
  repetitions    String       // Permite cosas como "12", "10-12" o "Al fallo"
  rest_time      Int?         // En segundos
  order          Int          // Orden de ejecución dentro de ese día (1º, 2º...) 

  trainingLogs   Training_Log[]

  @@unique([routine_day_id, exercise_id]) // No repetir ejercicio el mismo día
}

model Training_Log {
  id                  String           @id @default(uuid())
  client_id           String
  client              User             @relation(fields: [client_id], references: [id])
  routine_exercise_id String
  routine_exercise    Routine_Exercise @relation(fields: [routine_exercise_id], references: [id])
  weight_used         Float
  actual_reps         Int
  calories_burned     Float?
  recorded_at         DateTime         @default(now())
}

model Meal_Plan {
  id          String    @id @default(uuid())
  client_id   String
  client      User      @relation(fields: [client_id], references: [id])
  coach_id    String
  title       String
  description String?
  meals       Meal[]
  created_at  DateTime  @default(now())
  end_date    DateTime
}

model Meal {
  id           String     @id @default(uuid())
  meal_plan_id String
  mealPlan     Meal_Plan  @relation(fields: [meal_plan_id], references: [id], onDelete: Cascade)
  name         String
  order        Int
  items        Meal_Item[]
}

model Meal_Item {
  id           String   @id @default(uuid())
  meal_id      String
  meal         Meal     @relation(fields: [meal_id], references: [id], onDelete: Cascade)
  food_name    String
  quantity     String
  protein      Float
  carbs        Float
  fats         Float
  alternatives String?
}

model Chat_Message {
  id          String   @id @default(uuid())
  sender_id   String
  sender      User     @relation("SentMessages", fields: [sender_id], references: [id])
  receiver_id String
  receiver    User     @relation("ReceivedMessages", fields: [receiver_id], references: [id])
  content     String
  sent_at     DateTime @default(now())
}

model Partner {
  id         String   @id @default(uuid())
  name       String
  category   String
  logo_url   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  coupons    Coupon[]
}

model Coupon {
  id                  String   @id @default(uuid())
  partner_id          String
  partner             Partner  @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  
  gym_id              String?  // Nulo si el beneficio es de la red global, con ID si es local
  gym                 Gym?     @relation(fields: [gym_id], references: [id], onDelete: SetNull)
  
  code                String   @unique
  description         String
  discount_percentage Int
  expiration_date     DateTime
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
}